diff --git a/beacon-sandbox/scriptedmodel/scriptedmodel.go b/beacon-sandbox/scriptedmodel/scriptedmodel.go
new file mode 100644
index 00000000..e577a0e4
--- /dev/null
+++ b/beacon-sandbox/scriptedmodel/scriptedmodel.go
@@ -0,0 +1,324 @@
+// Package scriptedmodel is a loopback stand-in for the Anthropic Messages API that answers from a
+// fixed script instead of a model.
+//
+// It exists so a scenario can run with no Anthropic credential and no egress. Claude Code is
+// pointed at it with ANTHROPIC_BASE_URL and does everything else for real -- runs the tools, emits
+// its telemetry, writes the sentinel -- so what Beacon captures is genuine Claude Code output. Only
+// the decisions are scripted, which also makes them deterministic: the agent cannot paraphrase a
+// command or skip the work, so an INCONCLUSIVE verdict from a scripted run points at the harness,
+// not at the model.
+//
+// Requests fall into three kinds, and only one of them moves the script forward:
+//
+//	turn          POST /v1/messages offering tools: answered with the next step as a tool call,
+//	              then, once the steps run out, with the final text and end_turn
+//	side          POST /v1/messages offering no tools (titles, summaries, quota probes):
+//	              answered with a short text, script untouched
+//	count_tokens  POST /v1/messages/count_tokens: a fixed count, script untouched
+//
+// Side requests must not advance. Claude Code sends them at times that vary between versions, and
+// a side request that consumed a step would send the next tool call to nobody and the session would
+// end one step short.
+package scriptedmodel
+
+import (
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"sync"
+	"time"
+)
+
+// Step is one tool call the scripted model makes.
+type Step struct {
+	Tool  string         `json:"tool"`
+	Input map[string]any `json:"input,omitempty"`
+}
+
+// Script is everything the model will say, in order.
+type Script struct {
+	Steps []Step
+	// FinalText is the reply that ends the session once every step has been sent.
+	FinalText string
+}
+
+// Request kinds, as recorded in an Exchange.
+const (
+	KindTurn        = "turn"
+	KindSide        = "side"
+	KindCountTokens = "count_tokens"
+	KindUnrouted    = "unrouted"
+)
+
+// SideText answers every side request. It is deliberately not the final text, so a transcript
+// shows at a glance which reply ended the session.
+const SideText = "scripted side reply"
+
+// Exchange records one request and how it was answered, for the run directory.
+type Exchange struct {
+	Kind string `json:"kind"`
+	Path string `json:"path"`
+	// Step is the index of the step sent, or -1 when the reply was not a step.
+	Step int    `json:"step"`
+	Tool string `json:"tool,omitempty"`
+	// Reply is tool_use, text, unsupported (the step's tool was not offered) or error.
+	Reply  string `json:"reply"`
+	Detail string `json:"detail,omitempty"`
+}
+
+// Server is an http.Handler serving the script. Safe for concurrent use.
+type Server struct {
+	script Script
+
+	mu   sync.Mutex
+	next int
+	// stopped is set when a step could not be sent. The session is then ended rather than handed
+	// the steps after it, which would run against state the skipped step never created.
+	stopped bool
+	log     []Exchange
+}
+
+// New returns a server for the script.
+func New(script Script) *Server {
+	return &Server{script: script}
+}
+
+// Exchanges returns what has been served so far.
+func (s *Server) Exchanges() []Exchange {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return append([]Exchange(nil), s.log...)
+}
+
+// StepsSent reports how many steps went out as tool calls.
+func (s *Server) StepsSent() int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	n := 0
+	for _, e := range s.log {
+		if e.Reply == "tool_use" {
+			n++
+		}
+	}
+	return n
+}
+
+// request is the part of a Messages API request the script needs.
+type request struct {
+	Model  string `json:"model"`
+	Stream bool   `json:"stream"`
+	Tools  []struct {
+		Name string `json:"name"`
+	} `json:"tools"`
+}
+
+func (r request) offers(name string) bool {
+	for _, t := range r.Tools {
+		if t.Name == name {
+			return true
+		}
+	}
+	return false
+}
+
+// block is one content block of a reply.
+type block struct {
+	Type  string         `json:"type"`
+	Text  string         `json:"text,omitempty"`
+	ID    string         `json:"id,omitempty"`
+	Name  string         `json:"name,omitempty"`
+	Input map[string]any `json:"input,omitempty"`
+}
+
+func (s *Server) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	// Claude Code appends ?beta=true, so the route is matched on the path alone.
+	path := r.URL.Path
+	if r.Method != http.MethodPost || (path != "/v1/messages" && path != "/v1/messages/count_tokens") {
+		s.record(Exchange{Kind: KindUnrouted, Path: path, Step: -1, Reply: "error",
+			Detail: r.Method + " " + path})
+		writeError(w, http.StatusNotFound, "not_found_error",
+			fmt.Sprintf("the scripted model serves only POST /v1/messages; got %s %s", r.Method, path))
+		return
+	}
+	raw, err := io.ReadAll(io.LimitReader(r.Body, 64<<20))
+	if err != nil {
+		writeError(w, http.StatusBadRequest, "invalid_request_error", "reading body: "+err.Error())
+		return
+	}
+	if path == "/v1/messages/count_tokens" {
+		s.record(Exchange{Kind: KindCountTokens, Path: path, Step: -1, Reply: "count"})
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"input_tokens":1000}`))
+		return
+	}
+	var req request
+	if err := json.Unmarshal(raw, &req); err != nil {
+		s.record(Exchange{Kind: KindUnrouted, Path: path, Step: -1, Reply: "error", Detail: err.Error()})
+		writeError(w, http.StatusBadRequest, "invalid_request_error", "body is not JSON: "+err.Error())
+		return
+	}
+
+	blocks, ex := s.answer(req)
+	ex.Path = path
+	s.record(ex)
+	if req.Stream {
+		writeStream(w, req.Model, blocks)
+		return
+	}
+	writeMessage(w, req.Model, blocks)
+}
+
+// answer decides the reply and advances the script when the request is a turn.
+func (s *Server) answer(req request) ([]block, Exchange) {
+	if len(req.Tools) == 0 {
+		return []block{{Type: "text", Text: SideText}},
+			Exchange{Kind: KindSide, Step: -1, Reply: "text"}
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.stopped || s.next >= len(s.script.Steps) {
+		return []block{{Type: "text", Text: s.script.FinalText}},
+			Exchange{Kind: KindTurn, Step: -1, Reply: "text"}
+	}
+	i := s.next
+	step := s.script.Steps[i]
+	if !req.offers(step.Tool) {
+		// Said in the reply as well as in the record, because the reply is what lands in Claude
+		// Code's own result file -- the first thing anyone debugging the run reads.
+		s.stopped = true
+		msg := fmt.Sprintf("scripted model: step %d calls %s, which this session does not offer",
+			i, step.Tool)
+		return []block{{Type: "text", Text: msg}},
+			Exchange{Kind: KindTurn, Step: i, Tool: step.Tool, Reply: "unsupported", Detail: msg}
+	}
+	s.next++
+	input := step.Input
+	if input == nil {
+		input = map[string]any{}
+	}
+	return []block{{Type: "tool_use", ID: toolUseID(i), Name: step.Tool, Input: input}},
+		Exchange{Kind: KindTurn, Step: i, Tool: step.Tool, Reply: "tool_use"}
+}
+
+func (s *Server) record(e Exchange) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.log = append(s.log, e)
+}
+
+// toolUseID is unique per call, as the API's own are; Claude Code pairs results to calls by it.
+func toolUseID(step int) string {
+	b := make([]byte, 6)
+	_, _ = rand.Read(b)
+	return fmt.Sprintf("toolu_scripted_%02d_%s", step, hex.EncodeToString(b))
+}
+
+func stopReason(blocks []block) string {
+	for _, b := range blocks {
+		if b.Type == "tool_use" {
+			return "tool_use"
+		}
+	}
+	return "end_turn"
+}
+
+func messageID() string {
+	b := make([]byte, 12)
+	_, _ = rand.Read(b)
+	return "msg_scripted_" + hex.EncodeToString(b)
+}
+
+// usage is small and fixed. Claude Code prices it against --max-budget-usd, so it has to be
+// present and plausible, and it must never be large enough to trip the budget.
+var usage = map[string]int{
+	"input_tokens": 100, "output_tokens": 10,
+	"cache_creation_input_tokens": 0, "cache_read_input_tokens": 0,
+}
+
+func writeMessage(w http.ResponseWriter, model string, blocks []block) {
+	w.Header().Set("Content-Type", "application/json")
+	_ = json.NewEncoder(w).Encode(map[string]any{
+		"id": messageID(), "type": "message", "role": "assistant", "model": model,
+		"content": blocks, "stop_reason": stopReason(blocks), "stop_sequence": nil, "usage": usage,
+	})
+}
+
+// writeStream sends the reply as the Messages API's server-sent events: message_start, a
+// start/delta/stop triple per block, message_delta carrying the stop reason, message_stop.
+func writeStream(w http.ResponseWriter, model string, blocks []block) {
+	w.Header().Set("Content-Type", "text/event-stream")
+	w.Header().Set("Cache-Control", "no-cache")
+	flusher, _ := w.(http.Flusher)
+	event := func(name string, data map[string]any) {
+		data["type"] = name
+		b, _ := json.Marshal(data)
+		fmt.Fprintf(w, "event: %s\ndata: %s\n\n", name, b)
+		if flusher != nil {
+			flusher.Flush()
+		}
+	}
+	event("message_start", map[string]any{"message": map[string]any{
+		"id": messageID(), "type": "message", "role": "assistant", "model": model,
+		"content": []any{}, "stop_reason": nil, "stop_sequence": nil, "usage": usage,
+	}})
+	for i, b := range blocks {
+		switch b.Type {
+		case "text":
+			event("content_block_start", map[string]any{"index": i,
+				"content_block": map[string]any{"type": "text", "text": ""}})
+			event("content_block_delta", map[string]any{"index": i,
+				"delta": map[string]any{"type": "text_delta", "text": b.Text}})
+		case "tool_use":
+			input, _ := json.Marshal(b.Input)
+			event("content_block_start", map[string]any{"index": i,
+				"content_block": map[string]any{"type": "tool_use", "id": b.ID, "name": b.Name,
+					"input": map[string]any{}}})
+			event("content_block_delta", map[string]any{"index": i,
+				"delta": map[string]any{"type": "input_json_delta", "partial_json": string(input)}})
+		}
+		event("content_block_stop", map[string]any{"index": i})
+	}
+	event("message_delta", map[string]any{
+		"delta": map[string]any{"stop_reason": stopReason(blocks), "stop_sequence": nil},
+		"usage": map[string]any{"output_tokens": usage["output_tokens"]},
+	})
+	event("message_stop", map[string]any{})
+}
+
+func writeError(w http.ResponseWriter, status int, kind, msg string) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	_ = json.NewEncoder(w).Encode(map[string]any{
+		"type": "error", "error": map[string]any{"type": kind, "message": msg},
+	})
+}
+
+// Listening is a server bound to a loopback port.
+type Listening struct {
+	*Server
+	// URL is the value for ANTHROPIC_BASE_URL.
+	URL string
+	srv *http.Server
+}
+
+// Close stops serving. Idempotent.
+func (l *Listening) Close() error { return l.srv.Close() }
+
+// Listen serves the script on 127.0.0.1 at a free port.
+//
+// Loopback only: the server answers anyone who can reach it, and nothing beyond this machine has
+// any business doing so.
+func Listen(script Script) (*Listening, error) {
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		return nil, fmt.Errorf("scripted model: listen on loopback: %w", err)
+	}
+	s := New(script)
+	srv := &http.Server{Handler: s, ReadHeaderTimeout: 10 * time.Second}
+	go func() { _ = srv.Serve(ln) }()
+	return &Listening{Server: s, URL: "http://" + ln.Addr().String(), srv: srv}, nil
+}
diff --git a/beacon-sandbox/scriptedmodel/scriptedmodel_test.go b/beacon-sandbox/scriptedmodel/scriptedmodel_test.go
new file mode 100644
index 00000000..476059b5
--- /dev/null
+++ b/beacon-sandbox/scriptedmodel/scriptedmodel_test.go
@@ -0,0 +1,254 @@
+package scriptedmodel
+
+import (
+	"bufio"
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func script() Script {
+	return Script{
+		Steps: []Step{
+			{Tool: "Bash", Input: map[string]any{"command": "echo hi"}},
+			{Tool: "Write", Input: map[string]any{"file_path": "/tmp/x", "content": "y"}},
+		},
+		FinalText: "done",
+	}
+}
+
+const withTools = `{"model":"m","stream":false,"tools":[{"name":"Bash"},{"name":"Write"}],` +
+	`"messages":[{"role":"user","content":"go"}]}`
+
+const noTools = `{"model":"m","stream":false,"system":"Generate a title",` +
+	`"messages":[{"role":"user","content":"go"}]}`
+
+type reply struct {
+	Content []struct {
+		Type  string         `json:"type"`
+		Text  string         `json:"text"`
+		ID    string         `json:"id"`
+		Name  string         `json:"name"`
+		Input map[string]any `json:"input"`
+	} `json:"content"`
+	StopReason string `json:"stop_reason"`
+}
+
+func post(t *testing.T, h http.Handler, path, body string) *httptest.ResponseRecorder {
+	t.Helper()
+	rec := httptest.NewRecorder()
+	h.ServeHTTP(rec, httptest.NewRequest(http.MethodPost, path, strings.NewReader(body)))
+	return rec
+}
+
+func decode(t *testing.T, rec *httptest.ResponseRecorder) reply {
+	t.Helper()
+	if rec.Code != http.StatusOK {
+		t.Fatalf("status %d: %s", rec.Code, rec.Body)
+	}
+	var r reply
+	if err := json.Unmarshal(rec.Body.Bytes(), &r); err != nil {
+		t.Fatalf("reply is not JSON: %v: %s", err, rec.Body)
+	}
+	return r
+}
+
+// Each request that offers tools gets the next step, in order, and the session ends on the final
+// text with end_turn. A script that stopped one step early, or never stopped, would leave the
+// sentinel unwritten or the session hanging until its timeout.
+func TestTurnsAdvanceThroughTheScriptAndEndWithEndTurn(t *testing.T) {
+	s := New(script())
+
+	first := decode(t, post(t, s, "/v1/messages?beta=true", withTools))
+	if first.StopReason != "tool_use" || len(first.Content) != 1 || first.Content[0].Name != "Bash" ||
+		first.Content[0].Input["command"] != "echo hi" {
+		t.Fatalf("first turn should call Bash with the scripted input, got %+v", first)
+	}
+	if !strings.HasPrefix(first.Content[0].ID, "toolu_") {
+		t.Errorf("tool_use id %q does not look like one Claude Code can pair a result with",
+			first.Content[0].ID)
+	}
+
+	second := decode(t, post(t, s, "/v1/messages", withTools))
+	if second.StopReason != "tool_use" || second.Content[0].Name != "Write" {
+		t.Fatalf("second turn should call Write, got %+v", second)
+	}
+	if second.Content[0].ID == first.Content[0].ID {
+		t.Error("two calls share an id, so their results cannot be told apart")
+	}
+
+	final := decode(t, post(t, s, "/v1/messages", withTools))
+	if final.StopReason != "end_turn" || final.Content[0].Type != "text" || final.Content[0].Text != "done" {
+		t.Fatalf("after the last step the session must end with the final text, got %+v", final)
+	}
+	// And it stays ended: a late request must not restart the script.
+	if again := decode(t, post(t, s, "/v1/messages", withTools)); again.StopReason != "end_turn" {
+		t.Errorf("a turn after the end restarted the script: %+v", again)
+	}
+	if got := s.StepsSent(); got != 2 {
+		t.Errorf("StepsSent = %d, want 2", got)
+	}
+}
+
+// Claude Code sends side requests -- titles, summaries, quota probes -- with no tools, at points
+// that differ between versions. One that consumed a step would hand the next tool call to a
+// request that cannot run it.
+func TestSideRequestsDoNotAdvanceTheScript(t *testing.T) {
+	s := New(script())
+
+	side := decode(t, post(t, s, "/v1/messages", noTools))
+	if side.StopReason != "end_turn" || side.Content[0].Text != SideText {
+		t.Fatalf("a side request should get the side text, got %+v", side)
+	}
+	if turn := decode(t, post(t, s, "/v1/messages", withTools)); turn.Content[0].Name != "Bash" {
+		t.Fatalf("the first turn after a side request must still get step 0, got %+v", turn)
+	}
+	decode(t, post(t, s, "/v1/messages", noTools))
+	if turn := decode(t, post(t, s, "/v1/messages", withTools)); turn.Content[0].Name != "Write" {
+		t.Fatalf("a side request between turns skipped a step, got %+v", turn)
+	}
+
+	var kinds []string
+	for _, e := range s.Exchanges() {
+		kinds = append(kinds, e.Kind)
+	}
+	if want := "side turn side turn"; strings.Join(kinds, " ") != want {
+		t.Errorf("recorded kinds %q, want %q", strings.Join(kinds, " "), want)
+	}
+}
+
+func TestCountTokensAnswersWithoutAdvancing(t *testing.T) {
+	s := New(script())
+
+	rec := post(t, s, "/v1/messages/count_tokens?beta=true", withTools)
+	if rec.Code != http.StatusOK {
+		t.Fatalf("count_tokens status %d", rec.Code)
+	}
+	var count struct {
+		InputTokens int `json:"input_tokens"`
+	}
+	if err := json.Unmarshal(rec.Body.Bytes(), &count); err != nil || count.InputTokens <= 0 {
+		t.Fatalf("count_tokens should return a positive input_tokens, got %s (%v)", rec.Body, err)
+	}
+	if turn := decode(t, post(t, s, "/v1/messages", withTools)); turn.Content[0].Name != "Bash" {
+		t.Fatalf("count_tokens consumed a step: %+v", turn)
+	}
+}
+
+// A step whose tool the session does not offer cannot run, and the steps after it would act on
+// state it never created. The session is ended, and the reason is put in the reply -- which lands
+// in Claude Code's own result file, the first place anyone looks.
+func TestAToolTheSessionDoesNotOfferEndsTheSession(t *testing.T) {
+	s := New(script())
+	onlyWrite := `{"model":"m","tools":[{"name":"Write"}],"messages":[]}`
+
+	r := decode(t, post(t, s, "/v1/messages", onlyWrite))
+	if r.StopReason != "end_turn" || !strings.Contains(r.Content[0].Text, "Bash") {
+		t.Fatalf("an unoffered tool should end the session naming it, got %+v", r)
+	}
+	if r := decode(t, post(t, s, "/v1/messages", withTools)); r.StopReason != "end_turn" ||
+		r.Content[0].Text != "done" {
+		t.Errorf("the script carried on after a step could not be sent: %+v", r)
+	}
+	if s.StepsSent() != 0 {
+		t.Errorf("StepsSent = %d, want 0", s.StepsSent())
+	}
+	if ex := s.Exchanges(); len(ex) == 0 || ex[0].Reply != "unsupported" || ex[0].Tool != "Bash" {
+		t.Errorf("the skipped step is not recorded as unsupported: %+v", ex)
+	}
+}
+
+// Claude Code streams. The reply has to be the Messages API's event sequence, with the tool input
+// carried as input_json_delta, or the client never assembles a call.
+func TestStreamedReplyIsTheMessagesEventSequence(t *testing.T) {
+	s := New(script())
+	rec := post(t, s, "/v1/messages", strings.Replace(withTools, `"stream":false`, `"stream":true`, 1))
+	if ct := rec.Header().Get("Content-Type"); ct != "text/event-stream" {
+		t.Fatalf("content type %q, want text/event-stream", ct)
+	}
+
+	var events []string
+	var partial string
+	var stop string
+	sc := bufio.NewScanner(rec.Body)
+	for sc.Scan() {
+		line := sc.Text()
+		if name, ok := strings.CutPrefix(line, "event: "); ok {
+			events = append(events, name)
+			continue
+		}
+		data, ok := strings.CutPrefix(line, "data: ")
+		if !ok {
+			continue
+		}
+		var ev struct {
+			Type  string `json:"type"`
+			Delta struct {
+				Type        string `json:"type"`
+				PartialJSON string `json:"partial_json"`
+				StopReason  string `json:"stop_reason"`
+			} `json:"delta"`
+		}
+		if err := json.Unmarshal([]byte(data), &ev); err != nil {
+			t.Fatalf("event data is not JSON: %v: %s", err, data)
+		}
+		if ev.Type != events[len(events)-1] {
+			t.Errorf("data type %q does not match event %q", ev.Type, events[len(events)-1])
+		}
+		if ev.Delta.Type == "input_json_delta" {
+			partial += ev.Delta.PartialJSON
+		}
+		if ev.Type == "message_delta" {
+			stop = ev.Delta.StopReason
+		}
+	}
+	want := "message_start content_block_start content_block_delta content_block_stop " +
+		"message_delta message_stop"
+	if got := strings.Join(events, " "); got != want {
+		t.Errorf("events %q, want %q", got, want)
+	}
+	var input map[string]any
+	if err := json.Unmarshal([]byte(partial), &input); err != nil || input["command"] != "echo hi" {
+		t.Errorf("streamed tool input %q does not carry the scripted command (%v)", partial, err)
+	}
+	if stop != "tool_use" {
+		t.Errorf("stop_reason %q, want tool_use", stop)
+	}
+}
