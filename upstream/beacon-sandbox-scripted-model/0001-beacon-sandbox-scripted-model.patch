+// Scripted returns the scenarios that carry a script, reporting how many were set aside for the
+// same reason For does: a suite run that quietly shrank would read as full coverage.
+func (s Suite) Scripted() (matching Suite, skipped int) {
+	out := Suite{Name: s.Name}
+	for _, sc := range s.Scenarios {
+		if sc.HasScript() {
+			out.Scenarios = append(out.Scenarios, sc)
+			continue
+		}
+		skipped++
+	}
+	return out, skipped
