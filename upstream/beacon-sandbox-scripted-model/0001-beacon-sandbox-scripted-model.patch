+// checkModel reads --model and refuses the combinations that cannot work, before anything is
+// loaded or launched.
+//
+// A credential flag alongside the scripted model is refused rather than ignored: the caller plainly
+// expected a key to be used, and a run that silently used none would not be the run they asked for.
+func checkModel(flagValue, provider, modalSecret, keyCommand string) (runner.Model, error) {
+	model, err := runner.ParseModel(flagValue)
+	if err != nil {
+		return "", err
+	}
+	if model != runner.ModelScripted {
+		return model, nil
+	}
+	if provider != "local" {
+		// The stand-in runs in this process, on loopback, so only a guest that is this machine can
+		// reach it. A dispatched Windows run executes in a workflow that would need its own way to
+		// select the model, and a Modal guest would need the stand-in shipped into the image.
+		return "", fmt.Errorf("--model scripted needs --provider local for now: the scripted model is "+
+			"served from this process on loopback, which a %s guest cannot reach", provider)
+	}
+	if strings.TrimSpace(modalSecret) != "" || strings.TrimSpace(keyCommand) != "" {
+		return "", fmt.Errorf("--model scripted uses no credential; drop --modal-secret and --api-key-command")
+	}
+	return model, nil
+}
+
+// scriptedSuite narrows a suite to the scenarios the scripted model can run, saying how many were
+// set aside. A named scenario without a script is an error rather than an empty run: the caller
+// asked for that check specifically and would otherwise get "no scenario with id", which is false.
+func scriptedSuite(sui scenario.Suite, only string) (scenario.Suite, error) {
+	if only != "" {
+		for _, sc := range sui.Scenarios {
+			if sc.ID == only && !sc.HasScript() {
+				return sui, fmt.Errorf("%s has no script:, so it cannot run against the scripted model", only)
+			}
+		}
+	}
+	scripted, skipped := sui.Scripted()
+	if skipped > 0 {
+		fmt.Printf("scripted model: %d scenario(s) have a script; %d without one not run\n",
+			len(scripted.Scenarios), skipped)
+	}
+	if len(scripted.Scenarios) == 0 {
+		return scripted, fmt.Errorf("no scenario in this suite has a script:, so --model scripted would assert nothing")
+	}
+	return scripted, nil
+}
