+// Listen must serve on loopback only, and the URL it returns must be usable as
+// ANTHROPIC_BASE_URL as is.
+func TestListenServesOnLoopback(t *testing.T) {
+	l, err := Listen(script())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer l.Close()
+	if !strings.HasPrefix(l.URL, "http://127.0.0.1:") {
+		t.Fatalf("URL %q is not loopback", l.URL)
+	}
+	resp, err := http.Post(l.URL+"/v1/messages", "application/json", strings.NewReader(withTools))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer resp.Body.Close()
+	b, _ := io.ReadAll(resp.Body)
+	if resp.StatusCode != http.StatusOK || !strings.Contains(string(b), `"Bash"`) {
+		t.Errorf("status %d body %s", resp.StatusCode, b)
+	}
+}
