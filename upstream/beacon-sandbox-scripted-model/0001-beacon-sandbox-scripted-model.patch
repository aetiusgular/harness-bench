+package main
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/asymptote-labs/agent-beacon/beacon-sandbox/credentials"
+	"github.com/asymptote-labs/agent-beacon/beacon-sandbox/runner"
+	"github.com/asymptote-labs/agent-beacon/beacon-sandbox/scenario"
+)
+
+// Leaving --model unset must select the real API, so every existing invocation means what it did.
+func TestModelDefaultsToTheRealAPI(t *testing.T) {
+	for _, provider := range []string{"modal", "github", "local"} {
+		m, err := checkModel("anthropic", provider, "", "")
+		if err != nil || m != runner.ModelAnthropic {
+			t.Errorf("%s: checkModel(default) = %q, %v", provider, m, err)
+		}
+	}
+	// The real model with a credential flag is the ordinary case and must stay accepted.
+	if _, err := checkModel("anthropic", "modal", "stored", ""); err != nil {
+		t.Errorf("a credential flag with the real model was refused: %v", err)
+	}
+}
+
+func TestScriptedModelNeedsTheLocalProvider(t *testing.T) {
+	if m, err := checkModel("scripted", "local", "", ""); err != nil || m != runner.ModelScripted {
+		t.Fatalf("scripted on local should be accepted, got %q, %v", m, err)
+	}
+	for _, provider := range []string{"modal", "github"} {
+		_, err := checkModel("scripted", provider, "", "")
+		if err == nil || !strings.Contains(err.Error(), "--provider local") {
+			t.Errorf("%s: want a refusal naming --provider local, got %v", provider, err)
+		}
+	}
+}
+
+// A credential flag next to --model scripted means the caller expected a key to be used. Ignoring
+// it would hand them a keyless run they did not ask for.
+func TestScriptedModelRefusesACredentialFlag(t *testing.T) {
+	if _, err := checkModel("scripted", "local", "stored", ""); err == nil {
+		t.Error("--modal-secret was accepted with the scripted model")
+	}
+	if _, err := checkModel("scripted", "local", "", "op read x"); err == nil {
+		t.Error("--api-key-command was accepted with the scripted model")
+	}
+}
+
+func TestUnknownModelIsRefused(t *testing.T) {
+	if _, err := checkModel("claude-sonnet-4-5", "local", "", ""); err == nil {
+		t.Error("a Claude model name was accepted as --model; it selects nothing here")
+	}
+}
+
+func TestScriptedSuiteKeepsOnlyScriptedScenarios(t *testing.T) {
+	plain := scenario.Scenario{ID: "plain"}
+	scripted := scenario.Scenario{ID: "scripted", Script: []scenario.ScriptStep{{Tool: "Bash"}}}
+	sui := scenario.Suite{Scenarios: []scenario.Scenario{plain, scripted}}
+
+	got, err := scriptedSuite(sui, "")
+	if err != nil || len(got.Scenarios) != 1 || got.Scenarios[0].ID != "scripted" {
+		t.Errorf("scriptedSuite = %+v, %v", got.Scenarios, err)
+	}
+	// Naming a scenario that has no script must say so, not report the id as unknown.
+	if _, err := scriptedSuite(sui, "plain"); err == nil || !strings.Contains(err.Error(), "no script") {
+		t.Errorf("a named scenario without a script: got %v", err)
+	}
+	if _, err := scriptedSuite(scenario.Suite{Scenarios: []scenario.Scenario{plain}}, ""); err == nil {
+		t.Error("a suite with no script at all must be an error, not an empty run")
+	}
+}
+
+// Re-judging a scripted run offline must not pick up whatever key is in the environment then: the
+// run held none, so searching for that key would prove nothing about it.
+func TestOfflineVerifyOfAScriptedRunSearchesForNothing(t *testing.T) {
+	t.Setenv(credentials.EnvVar, "sk-ant-ambient")
+	got := offlineCredential(map[string]string{"credential_source": string(credentials.SourceScripted)})
+	if got.Source != credentials.SourceScripted || got.LeakCheckPossible() {
+		t.Errorf("offlineCredential = %+v, want the scripted source with nothing to search for", got)
+	}
+}
