@@ -0,0 +1,168 @@
+package scenario
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// A script is decoded from YAML into plain maps, nested values included, because the scripted
+// model marshals the input to JSON verbatim. yaml.v3 decodes a nested mapping to map[string]any,
+// which marshals; a map[any]any would not.
+func TestScriptDecodesFromYAML(t *testing.T) {
+	dir := t.TempDir()
+	p := filepath.Join(dir, "x.yaml")
+	body := `id: t-script
+prompt: run it
+expect:
+  - action: command.executed
+    why: test
+script:
+  - tool: Bash
+    input:
+      command: echo {{canary}}
+      nested: {list: ["{{sentinel}}", 3]}
+  - tool: Write
+`
+	if err := os.WriteFile(p, []byte(body), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	s, err := Load(p)
+	if err != nil {
+		t.Fatalf("Load: %v", err)
+	}
+	if len(s.Script) != 2 || s.Script[0].Tool != "Bash" || s.Script[1].Tool != "Write" {
+		t.Fatalf("script decoded as %+v", s.Script)
+	}
+	nested, ok := s.Script[0].Input["nested"].(map[string]any)
+	if !ok {
+		t.Fatalf("a nested mapping decoded as %T, which does not marshal to JSON",
+			s.Script[0].Input["nested"])
+	}
+	if list, ok := nested["list"].([]any); !ok || len(list) != 2 {
+		t.Errorf("nested list decoded as %#v", nested["list"])
+	}
+	if s.Script[1].Input != nil {
+		t.Errorf("a step without input should decode to nil input, got %#v", s.Script[1].Input)
+	}
+	if !s.HasScript() {
+		t.Error("HasScript is false for a scenario with a script")
+	}
+}
+
+// A misspelled key inside a step must fail the load, the same as anywhere else in a scenario.
+func TestScriptRejectsUnknownStepFields(t *testing.T) {
+	dir := t.TempDir()
+	p := filepath.Join(dir, "x.yaml")
+	body := "id: t\nprompt: p\nexpect: [{action: a, why: w}]\nscript:\n  - tool: Bash\n    inputs: {}\n"
+	if err := os.WriteFile(p, []byte(body), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := Load(p); err == nil {
+		t.Error("`inputs:` loaded without error, so the step would silently run with no input")
+	}
+}
+
+// Each of these could never play out: the scripted model ends the session at the first step whose
+// tool is not offered, which would read as an idle agent after a sandbox was already paid for.
+func TestValidateRejectsAScriptThatCannotPlayOut(t *testing.T) {
+	cases := map[string]func(*Scenario){
+		"missing tool":    func(s *Scenario) { s.Script = []ScriptStep{{}} },
+		"whitespace tool": func(s *Scenario) { s.Script = []ScriptStep{{Tool: " Bash"}} },
+		"tool not in tools:": func(s *Scenario) {
+			s.Tools = []string{"Write"}
+			s.Script = []ScriptStep{{Tool: "Bash"}}
+		},
+		"tools: [] offers nothing": func(s *Scenario) {
+			s.Tools = []string{}
+			s.Script = []ScriptStep{{Tool: "Bash"}}
+		},
+		"tool disallowed": func(s *Scenario) {
+			s.DisallowedTools = []string{"Bash"}
+			s.Script = []ScriptStep{{Tool: "Bash"}}
+		},
+	}
+	for name, mutate := range cases {
+		s := valid()
+		mutate(&s)
+		if err := s.Validate(); err == nil {
+			t.Errorf("%s: expected a validation error, got nil", name)
+		}
+	}
+}
+
+func TestValidateAcceptsAScriptTheToolListAllows(t *testing.T) {
+	s := valid()
+	s.Tools = []string{"Bash(echo:*)", "Write"}
+	s.Script = []ScriptStep{{Tool: "Bash"}, {Tool: "Write"}}
+	if err := s.Validate(); err != nil {
+		t.Errorf("a tool allowed with a rule should count as offered: %v", err)
+	}
+}
+
+func TestScriptedSelectsScenariosWithAScriptAndCountsTheRest(t *testing.T) {
+	with, without := valid(), valid()
+	with.ID, without.ID = "with", "without"
+	with.Script = []ScriptStep{{Tool: "Bash"}}
+	got, skipped := Suite{Name: "s", Scenarios: []Scenario{without, with}}.Scripted()
+	if len(got.Scenarios) != 1 || got.Scenarios[0].ID != "with" || skipped != 1 {
+		t.Errorf("Scripted() = %v ids, skipped %d", got.Scenarios, skipped)
+	}
+}
+
+// Placeholders are expanded at every depth, and the scenario's own value is not modified --
+// --repeat expands the same scenario again with a different canary.
+func TestExpandInputIsDeepAndDoesNotMutate(t *testing.T) {
+	in := map[string]any{
+		"command": "echo {{canary}}",
+		"nested":  map[string]any{"path": "{{workdir}}/x", "n": 3},
+		"list":    []any{"{{sentinel}}", true},
+	}
+	out := ExpandInput(in, "C1", "/w/s", "/w")
+	if out["command"] != "echo C1" {
+		t.Errorf("command = %v", out["command"])
+	}
+	if out["nested"].(map[string]any)["path"] != "/w/x" || out["nested"].(map[string]any)["n"] != 3 {
+		t.Errorf("nested = %v", out["nested"])
+	}
+	if l := out["list"].([]any); l[0] != "/w/s" || l[1] != true {
+		t.Errorf("list = %v", l)
+	}
+	if in["command"] != "echo {{canary}}" || in["nested"].(map[string]any)["path"] != "{{workdir}}/x" {
+		t.Error("ExpandInput modified the scenario's own input")
+	}
+	if ExpandInput(nil, "c", "s", "w") != nil {
+		t.Error("a nil input should stay nil")
+	}
+}
+
+// The shipped scripts must do what their prompts ask. A script that drifted from its prompt would
+// make a scripted run assert something other than the real-model run of the same scenario.
+func TestShippedScriptsMatchTheirPrompts(t *testing.T) {
+	suite, err := LoadSuite("../scenarios")
+	if err != nil {
+		t.Fatalf("LoadSuite: %v", err)
+	}
+	scripted, _ := suite.Scripted()
+	if len(scripted.Scenarios) == 0 {
+		t.Fatal("no shipped scenario has a script, so `run --model scripted` has nothing to run")
+	}
+	for _, sc := range scripted.Scenarios {
+		const canary = "BEACON_SANDBOX_TEST"
+		sentinel := Expand(sc.Sentinel, canary, "", "/home/agent/work")
+		prompt := Expand(sc.Prompt, canary, sentinel, "/home/agent/work")
+		for i, st := range sc.Script {
+			in := ExpandInput(st.Input, canary, sentinel, "/home/agent/work")
+			for k, v := range in {
+				str, ok := v.(string)
+				if !ok || k == "description" {
+					continue
+				}
+				if !strings.Contains(prompt, strings.TrimSpace(str)) {
+					t.Errorf("%s: script[%d].%s = %q is not what the prompt asks for", sc.ID, i, k, str)
+				}
+			}
+		}
+	}
+}
