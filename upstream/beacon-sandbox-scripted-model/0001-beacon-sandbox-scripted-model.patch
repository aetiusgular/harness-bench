+func TestUnknownRoutesAre404AndRecorded(t *testing.T) {
+	s := New(script())
+	rec := httptest.NewRecorder()
+	s.ServeHTTP(rec, httptest.NewRequest(http.MethodHead, "/api/hello", nil))
+	if rec.Code != http.StatusNotFound {
+		t.Errorf("HEAD /api/hello status %d, want 404", rec.Code)
+	}
+	if ex := s.Exchanges(); len(ex) != 1 || ex[0].Kind != KindUnrouted {
+		t.Errorf("an unrouted request was not recorded: %+v", ex)
+	}
+}
