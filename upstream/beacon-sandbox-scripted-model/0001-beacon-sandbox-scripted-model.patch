+// ExpandInput substitutes run-scoped placeholders into every string of a script step's input,
+// however deeply nested, and returns a copy. The scenario's own value is left untouched, because
+// the same scenario is expanded again with a fresh canary on every --repeat.
+func ExpandInput(in map[string]any, canary, sentinel, workdir string) map[string]any {
+	if in == nil {
+		return nil
+	}
+	out, _ := expandValue(in, canary, sentinel, workdir).(map[string]any)
+	return out
+}
+
+func expandValue(v any, canary, sentinel, workdir string) any {
+	switch t := v.(type) {
+	case string:
+		return Expand(t, canary, sentinel, workdir)
+	case map[string]any:
+		out := make(map[string]any, len(t))
+		for k, e := range t {
+			out[k] = expandValue(e, canary, sentinel, workdir)
+		}
+		return out
+	case []any:
+		out := make([]any, len(t))
+		for i, e := range t {
+			out[i] = expandValue(e, canary, sentinel, workdir)
+		}
+		return out
+	default:
+		return v
+	}
+}
