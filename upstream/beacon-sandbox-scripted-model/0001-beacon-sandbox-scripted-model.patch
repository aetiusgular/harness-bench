+	withScript := scenario.Scenario{ID: "s", Script: []scenario.ScriptStep{{Tool: "Bash"}}}
+	if err := checkScripted(false, "modal", withScript); err == nil ||
+		!strings.Contains(err.Error(), "--provider local") {
+		t.Errorf("a remote guest must be refused with the provider that works, got %v", err)
+	}
+	if err := checkScripted(true, "local", scenario.Scenario{ID: "s"}); err == nil {
+		t.Error("a scenario without a script must be refused")
+	}
+	if err := checkScripted(true, "local", withScript); err != nil {
+		t.Errorf("local with a script should be accepted: %v", err)
+	}
