+
+// The assignments must land on `beacon ci exec` itself -- a POSIX prefix applies only to the one
+// command it precedes -- and must reach the process it starts, which is how Claude Code sees them.
+// Run through a real shell, because the property is about how sh parses the line.
+func TestSessionEnvReachesTheWrappedCommand(t *testing.T) {
+	sh := posixShell{}
+	env := scriptedSessionEnv("http://127.0.0.1:9")
+
+	wrapped := withSessionEnv(sh, env, sh.CIExecSession("/w/runtime.jsonl", "/w", []string{"-p", "x"}))
+	if !strings.Contains(wrapped, "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC='1' beacon ci exec ") {
+		t.Errorf("the assignments do not immediately precede beacon ci exec:\n%s", wrapped)
+	}
+
+	probe := withSessionEnv(sh, env,
+		`sh -c 'echo "url=$ANTHROPIC_BASE_URL token=$ANTHROPIC_AUTH_TOKEN key=[${ANTHROPIC_API_KEY-unset}]"'`)
+	cmd := exec.Command("sh", "-c", probe)
+	// A real key in the parent environment is the case that matters: it must not reach the agent.
+	cmd.Env = append(os.Environ(), "ANTHROPIC_API_KEY=sk-ant-real", "CLAUDE_CODE_OAUTH_TOKEN=real")
+	out, err := cmd.Output()
+	if err != nil {
+		t.Fatalf("sh: %v", err)
+	}
+	want := "url=http://127.0.0.1:9 token=" + scriptedToken + " key=[]"
+	if got := strings.TrimSpace(string(out)); got != want {
+		t.Errorf("child saw %q, want %q", got, want)
+	}
+}
+
+// PowerShell has no prefix form; the assignments become statements ahead of the script.
+func TestSessionEnvInPowerShellIsStatements(t *testing.T) {
+	got := withSessionEnv(powerShell{}, [][2]string{{"A", "x"}, {"B", ""}}, "& claude")
+	if want := "$env:A = 'x'; $env:B = ''; & claude"; got != want {
+		t.Errorf("got %q, want %q", got, want)
+	}
+}
+
+// Placeholders are expanded with this run's values before the server sees the script, and what
+// it answered is written to the run directory and summarized in meta.
+func TestScriptedServerIsExpandedAndRecorded(t *testing.T) {
+	sc := scenario.Scenario{ID: "s", Script: []scenario.ScriptStep{
+		{Tool: "Bash", Input: map[string]any{"command": "echo {{canary}} | tee {{sentinel}}"}},
+		{Tool: "Write", Input: map[string]any{"file_path": "{{workdir}}/x"}},
+	}}
+	m, err := startScripted(sc, "C1", "/w/s.sentinel", "/w")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer m.Close()
+
+	body := `{"model":"m","tools":[{"name":"Bash"}],"messages":[]}`
+	resp, err := http.Post(m.URL+"/v1/messages", "application/json", strings.NewReader(body))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var r struct {
+		Content []struct {
+			Input map[string]any `json:"input"`
+		} `json:"content"`
+	}
+	_ = json.NewDecoder(resp.Body).Decode(&r)
+	resp.Body.Close()
+	if len(r.Content) != 1 || r.Content[0].Input["command"] != "echo C1 | tee /w/s.sentinel" {
+		t.Fatalf("step 0 was not expanded: %+v", r)
+	}
+	// Step 1 calls Write, which this request does not offer, so the session is ended there.
+	resp, err = http.Post(m.URL+"/v1/messages", "application/json", strings.NewReader(body))
+	if err != nil {
+		t.Fatal(err)
+	}
+	resp.Body.Close()
+
+	dir := t.TempDir()
+	art := Artifacts{Meta: map[string]string{}}
+	recordScripted(m, len(sc.Script), dir, &art, func(string, ...any) {})
+	if art.Meta["scripted_steps_sent"] != "1/2" {
+		t.Errorf("scripted_steps_sent = %q, want 1/2", art.Meta["scripted_steps_sent"])
+	}
+	if !strings.Contains(art.Meta["scripted_stopped"], "Write") {
+		t.Errorf("scripted_stopped = %q, want it to name the tool that was not offered",
+			art.Meta["scripted_stopped"])
+	}
+	b, err := os.ReadFile(filepath.Join(dir, ScriptedTranscriptName))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var ex []scriptedmodel.Exchange
+	if err := json.Unmarshal(b, &ex); err != nil || len(ex) != 2 {
+		t.Errorf("transcript = %s (%v)", b, err)
+	}
+}
