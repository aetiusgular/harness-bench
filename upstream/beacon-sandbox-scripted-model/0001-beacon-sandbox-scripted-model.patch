+func TestParseModel(t *testing.T) {
+	for in, want := range map[string]Model{"": ModelAnthropic, "anthropic": ModelAnthropic,
+		"scripted": ModelScripted, " scripted ": ModelScripted} {
+		got, err := ParseModel(in)
