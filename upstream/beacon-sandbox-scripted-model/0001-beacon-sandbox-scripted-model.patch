+// validateScript rejects a script that could never play out as written.
+//
+// The scripted model ends the session at the first step whose tool the session does not offer, so
+// a step naming a tool the scenario itself restricted away would make every scripted run of it
+// stop there -- after a sandbox has been paid for, and reading as an idle agent.
+func (s Scenario) validateScript() error {
+	for i, st := range s.Script {
+		tool := strings.TrimSpace(st.Tool)
+		if tool == "" {
+			return fmt.Errorf("%s: script[%d] is missing tool", s.ID, i)
+		}
+		if tool != st.Tool {
+			return fmt.Errorf("%s: script[%d] tool %q has surrounding whitespace, so it would "+
+				"never match an offered tool", s.ID, i, st.Tool)
+		}
+		if s.Tools != nil && !namesTool(s.Tools, tool) {
+			return fmt.Errorf("%s: script[%d] calls %s, which tools: does not allow", s.ID, i, tool)
+		}
+		if namesTool(s.DisallowedTools, tool) {
+			return fmt.Errorf("%s: script[%d] calls %s, which disallowed_tools removes", s.ID, i, tool)
+		}
+	}
+	return nil
+}
+
+// namesTool reports whether a Claude Code tool list names the tool, bare or with a rule such as
+// "Bash(git:*)".
+func namesTool(list []string, tool string) bool {
+	for _, t := range list {
+		if t == tool || strings.HasPrefix(t, tool+"(") {
+			return true
+		}
+	}
+	return false
+}
+
+// HasScript reports whether the scenario can run against the scripted model.
+func (s Scenario) HasScript() bool { return len(s.Script) > 0 }
