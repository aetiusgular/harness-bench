diff --git a/beacon-sandbox/runner/scripted.go b/beacon-sandbox/runner/scripted.go
new file mode 100644
index 00000000..d9e0666b
--- /dev/null
+++ b/beacon-sandbox/runner/scripted.go
@@ -0,0 +1,123 @@
+package runner
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/asymptote-labs/agent-beacon/beacon-sandbox/scenario"
+	"github.com/asymptote-labs/agent-beacon/beacon-sandbox/scriptedmodel"
+)
+
+// Model selects what answers the agent.
+type Model string
+
+const (
+	// ModelAnthropic is the real Messages API, and the default: a run is a real agent session.
+	ModelAnthropic Model = "anthropic"
+	// ModelScripted is the scenario's own script, served on loopback by scriptedmodel. No
+	// credential, no API spend, and nothing leaves the machine on the model's behalf.
+	ModelScripted Model = "scripted"
+)
+
+// ParseModel reads the --model flag. Empty is the default.
+func ParseModel(s string) (Model, error) {
+	switch Model(strings.TrimSpace(s)) {
+	case "", ModelAnthropic:
+		return ModelAnthropic, nil
+	case ModelScripted:
+		return ModelScripted, nil
+	}
+	return "", fmt.Errorf("unknown --model %q; want %s or %s", s, ModelAnthropic, ModelScripted)
+}
+
+// ScriptedTranscriptName is where a scripted run records every request the model answered.
+const ScriptedTranscriptName = "scripted-model.json"
+
+// scriptedFinalText is the reply that ends a scripted session.
+const scriptedFinalText = "scripted session complete"
+
+// scriptedToken is what Claude Code presents to the scripted model. It has to present something or
+// it will not start; the stand-in accepts anything, so this is a fixed placeholder, not a secret.
+const scriptedToken = "beacon-sandbox-scripted-model"
+
+// checkScripted refuses a scripted run that cannot work, before anything is built or launched.
+//
+// The model is served from this process on 127.0.0.1, so it is reachable only when the guest is
+// this machine. Every remote provider puts the agent somewhere that address means something else.
+func checkScripted(mutatesHost bool, providerName string, sc scenario.Scenario) error {
+	if !mutatesHost {
+		return fmt.Errorf("--model scripted serves the model from this process on loopback, which "+
+			"the %s guest cannot reach; it needs --provider local", providerName)
+	}
+	if !sc.HasScript() {
+		return fmt.Errorf("%s has no script:, so there is nothing for the scripted model to do", sc.ID)
+	}
+	return nil
+}
+
+// startScripted serves the scenario's script with this run's placeholders expanded.
+func startScripted(sc scenario.Scenario, canary, sentinel, workdir string) (*scriptedmodel.Listening, error) {
+	steps := make([]scriptedmodel.Step, len(sc.Script))
+	for i, st := range sc.Script {
+		steps[i] = scriptedmodel.Step{
+			Tool:  st.Tool,
+			Input: scenario.ExpandInput(st.Input, canary, sentinel, workdir),
+		}
+	}
+	return scriptedmodel.Listen(scriptedmodel.Script{Steps: steps, FinalText: scriptedFinalText})
+}
+
+// scriptedSessionEnv points Claude Code at the scripted model.
+//
+// The real credentials are blanked rather than left alone. On the local provider the session
+// inherits this process's environment, and a CI job that also runs real-model scenarios has a key
+// there; Claude Code would then send it to the stand-in, and the run would no longer be the
+// keyless one it claims to be. The non-essential traffic switch keeps Claude Code's update check
+// and error reporting off the network; it does not affect the OpenTelemetry export Beacon reads.
+func scriptedSessionEnv(url string) [][2]string {
+	return [][2]string{
+		{"ANTHROPIC_BASE_URL", url},
+		{"ANTHROPIC_AUTH_TOKEN", scriptedToken},
+		{"ANTHROPIC_API_KEY", ""},
+		{"CLAUDE_CODE_OAUTH_TOKEN", ""},
+		{"CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC", "1"},
+	}
+}
+
+// withSessionEnv prefixes a session script with environment assignments, in order.
+func withSessionEnv(sh shell, env [][2]string, script string) string {
+	for i := len(env) - 1; i >= 0; i-- {
+		script = sh.WithEnv(env[i][0], env[i][1], script)
+	}
+	return script
+}
+
+// recordScripted writes the transcript and summarizes it into meta.
+//
+// Steps sent against steps scripted is the number to read first on a scripted run that did not
+// pass: fewer sent than scripted means the session ended early, and the transcript says where.
+func recordScripted(m *scriptedmodel.Listening, steps int, runDir string, art *Artifacts,
+	logf func(string, ...any)) {
+
+	ex := m.Exchanges()
+	art.Meta["scripted_steps_sent"] = fmt.Sprintf("%d/%d", m.StepsSent(), steps)
+	kinds := map[string]int{}
+	for _, e := range ex {
+		kinds[e.Kind]++
+		if e.Reply == "unsupported" {
+			art.Meta["scripted_stopped"] = oneLine(e.Detail)
+			logf("%s", e.Detail)
+		}
+	}
+	art.Meta["scripted_requests"] = fmt.Sprintf("turn=%d side=%d count_tokens=%d unrouted=%d",
+		kinds[scriptedmodel.KindTurn], kinds[scriptedmodel.KindSide],
+		kinds[scriptedmodel.KindCountTokens], kinds[scriptedmodel.KindUnrouted])
+	logf("scripted model: %s steps sent; requests %s",
+		art.Meta["scripted_steps_sent"], art.Meta["scripted_requests"])
+	if b, err := json.MarshalIndent(ex, "", "  "); err == nil {
+		_ = os.WriteFile(filepath.Join(runDir, ScriptedTranscriptName), append(b, '\n'), 0o600)
+	}
+}
