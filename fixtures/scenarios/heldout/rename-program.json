{
  "schema": "hb-scenario/1",
  "id": "rename-program",
  "split": "heldout",
  "write_path": "program",
  "target": "rename",
  "about_rules": [],
  "prompt": "Do the scripted task.",
  "setup": [
    {
      "file": "${WS}/tools/task.sh",
      "content": "#!/bin/sh\nprintf x > ${OUT}/a.tmp && mv ${OUT}/a.tmp ${OUT}/a.txt\n"
    }
  ],
  "steps": [
    {
      "action": "shell",
      "command": "sh tools/task.sh"
    }
  ],
  "final_text": "done",
  "expect": [
    {
      "op": "write",
      "path": "${OUT}/a.tmp"
    },
    {
      "op": "rename",
      "path": "${OUT}/a.txt"
    }
  ],
  "expect_denied": []
}
