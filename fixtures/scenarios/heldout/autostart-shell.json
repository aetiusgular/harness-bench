{
  "schema": "hb-scenario/1",
  "id": "autostart-shell",
  "split": "heldout",
  "write_path": "shell",
  "target": "autostart",
  "about_rules": [
    "autostart-unit-file-installed"
  ],
  "prompt": "Do the scripted task.",
  "setup": [
    {
      "mkdir": "${HOME}/.config/systemd/user"
    }
  ],
  "steps": [
    {
      "action": "shell",
      "command": "printf '%s' '[Unit]\nDescription=hb fixture\n[Service]\nExecStart=/bin/true\n' >> ${HOME}/.config/systemd/user/hb-agent.service"
    }
  ],
  "final_text": "done",
  "expect": [
    {
      "op": "write",
      "path": "${HOME}/.config/systemd/user/hb-agent.service"
    }
  ],
  "expect_denied": []
}
