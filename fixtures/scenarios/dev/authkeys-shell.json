{
  "schema": "hb-scenario/1",
  "id": "authkeys-shell",
  "split": "dev",
  "write_path": "shell",
  "target": "authkeys",
  "about_rules": [
    "ssh-authorized-keys-modified"
  ],
  "prompt": "Do the scripted task.",
  "setup": [
    {
      "mkdir": "${HOME}/.ssh"
    }
  ],
  "steps": [
    {
      "action": "shell",
      "command": "printf '%s' 'ssh-ed25519 hb-fixture-not-a-key hb@bench\n' >> ${HOME}/.ssh/authorized_keys"
    }
  ],
  "final_text": "done",
  "expect": [
    {
      "op": "write",
      "path": "${HOME}/.ssh/authorized_keys"
    }
  ],
  "expect_denied": []
}
