{
  "schema": "hb-scenario/1",
  "id": "hosts-program",
  "split": "dev",
  "write_path": "program",
  "target": "hosts",
  "about_rules": [
    "etc-hosts-modified"
  ],
  "prompt": "Do the scripted task.",
  "setup": [
    {
      "file": "${WS}/tools/task.sh",
      "content": "#!/bin/sh\nprintf '%s' '127.0.0.1 hb.invalid\n' >> /etc/hosts\n"
    }
  ],
  "steps": [
    {
      "action": "shell",
      "command": "sh tools/task.sh"
    }
  ],
  "final_text": "done",
  "expect": [],
  "expect_denied": [
    {
      "op": "write",
      "path": "/etc/hosts"
    }
  ]
}
